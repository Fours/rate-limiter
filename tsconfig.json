{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    // Node runs bench/ and examples/ by stripping types, which needs relative imports to end in .ts.
    "allowImportingTsExtensions": true,
    // Lets examples import the package by name before dist/ is built, as CI typechecks first.
    "paths": {
      "@kylewillett/rate-limiter": ["./src/index.ts"],
      "@kylewillett/rate-limiter/prometheus": ["./src/prometheus.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "bench",
    "scripts",
    "e2e",
    "demo/vite.config.ts",
    "demo/build",
    "*.config.ts"
  ]
}
