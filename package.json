{
  "name": "@kylewillett/rate-limiter",
  "version": "0.1.0",
  "description": "Distributed rate limiting middleware for Express, with pluggable algorithms and shared limits through Redis.",
  "license": "MIT",
  "author": "Kyle Willett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fours/rate-limiter.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --coverage",
    "redis:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "redis:down": "docker compose -f docker-compose.test.yml down",
    "stack:up": "docker compose up -d --build --wait",
    "stack:check": "bench/stack-check.sh",
    "stack:down": "docker compose down -v",
    "example": "npm run build && npm run example:serve",
    "example:serve": "node --experimental-strip-types examples/basic/server.ts"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.10",
    "redis": "^6.3.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  }
}
