{
  "name": "@kylewillett/rate-limiter",
  "version": "1.0.1",
  "description": "Distributed rate limiting middleware for Express, with pluggable algorithms and shared limits through Redis.",
  "license": "MIT",
  "author": "Kyle Willett",
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "express",
    "middleware",
    "redis",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "throttle",
    "distributed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fours/rate-limiter.git"
  },
  "homepage": "https://rate-limiter.kylewillett.com/",
  "bugs": {
    "url": "https://github.com/Fours/rate-limiter/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "import": "./dist/prometheus.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:package": "npm run build && vitest run --project package",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --coverage --project unit --project integration",
    "redis:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "redis:down": "docker compose -f docker-compose.test.yml down",
    "stack:up": "docker compose up -d --build --wait",
    "stack:check": "bench/stack-check.sh",
    "stack:observe": "METRICS=1 docker compose --profile observability up -d --build --wait",
    "stack:observe:check": "bench/observe-check.sh",
    "stack:down": "docker compose --profile observability down -v",
    "bench": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run.ts",
    "bench:analyse": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/analyse.ts",
    "bench:memory": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning bench/memory.ts",
    "example": "npm run build && npm run example:serve",
    "example:serve": "node --experimental-strip-types examples/basic/server.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "deploy": "bash scripts/deploy.sh",
    "test:e2e": "npm run demo:build && playwright test",
    "check:package": "node scripts/check-pack.js && publint && attw --pack --profile esm-only",
    "mutate": "stryker run",
    "mutate:lua": "node scripts/mutate-lua.js"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "prom-client": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/k6": "^2.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "posthog-js": "^1.447.8",
    "prettier": "^3.9.10",
    "prom-client": "^15.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wasmoon": "^1.16.0",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  }
}
