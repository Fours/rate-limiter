# PostHog analytics for the demo site. Copy this file to demo/.env.local and fill in your values.
# Vite reads env files from the demo's root (demo/), not the repo's. Without a key, nothing loads.
# Find these in PostHog under Settings → Project → General.
# The project API key is a write-only ingestion key and is safe to ship to the browser.
VITE_PUBLIC_POSTHOG_KEY=
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
